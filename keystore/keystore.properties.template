# Release signing configuration
# Copy this file to keystore.properties and fill in the values
# DO NOT commit keystore.properties to version control

storeFile=qrcord-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=qrcord
keyPassword=YOUR_KEY_PASSWORD

# To generate a keystore, run:
# keytool -genkey -v -keystore qrcord-release.keystore -alias qrcord -keyalg RSA -keysize 2048 -validity 10000
